# =============================================================================
# PERP ARB BOT - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# --- Master Wallet ---
# EVM private key (for Hyperliquid, Lighter, Ostium, Aster, EdgeX)
EVM_PRIVATE_KEY=0x_your_evm_private_key_here
EVM_PUBLIC_KEY=0x_your_evm_public_address_here

# Solana private key (for Drift) - base58 encoded
SOLANA_PRIVATE_KEY=your_solana_private_key_base58

# --- RPC Endpoints ---
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
ETHEREUM_RPC_URL=https://eth.llamarpc.com
BSC_RPC_URL=https://bsc-dataseed1.binance.org
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- Platform-Specific API Keys ---
# Hyperliquid API wallet (generated from app.hyperliquid.xyz > More > API)
HYPERLIQUID_API_WALLET_KEY=
HYPERLIQUID_API_WALLET_ADDRESS=

# Aster API (if using HMAC auth v1)
ASTER_API_KEY=
ASTER_API_SECRET=

# EdgeX API credentials
EDGEX_API_KEY=
EDGEX_API_SECRET=
EDGEX_STARK_PRIVATE_KEY=

# --- Arbitrage Parameters ---
ENTRY_FUNDING_RATE_DIFF_PCT=10.0
EXIT_FUNDING_RATE_DIFF_PCT=3.0
MIN_ACCOUNT_BALANCE_USD=150.0
POSITION_SIZE_PCT=25.0
MAX_CONCURRENT_POSITIONS=5

# --- Monitoring & Alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# --- Dashboard ---
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
DASHBOARD_SECRET_KEY=change_this_to_random_string

# --- Scheduler ---
# Polling interval in seconds
FUNDING_RATE_POLL_INTERVAL=300
POSITION_CHECK_INTERVAL=60

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=perp_arb_bot.log

# --- Security ---
# Max slippage tolerance (%)
MAX_SLIPPAGE_PCT=0.5
# Minimum profit threshold after fees (USD)
MIN_PROFIT_THRESHOLD_USD=0.5
# Enable dry-run mode (no real trades)
DRY_RUN=false
